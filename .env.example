# Backend Environment Variables

# Database Configuration
PORT=8080
DATABASE_DSN=host=localhost user=postgres password=postgres dbname=capyflow port=5432 sslmode=disable
ENVIROMENT=development

# AI Generation - REQUIRED for AI features
# Get your FREE API key at: https://console.groq.com/keys
# Groq offers generous free tier with fast LLMs
GROQ_API_KEY=your-groq-api-key-here

# Email Provider (optional)
# If Email node uses provider=sendgrid-api and no token is set in the node,
# backend will use this token.
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_SENDER_EMAIL=sender@example.com
SENDGRID_SENDER_NAME=CapyFlow Demo

# JWT Secret (Change in production!)
# JWT_SECRET=your-secret-key-here
